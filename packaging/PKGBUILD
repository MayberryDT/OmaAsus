# Maintainer: Brian Honeycutt
pkgname=omaasus
pkgver=0.1.0
pkgrel=1
pkgdesc="High-design control center and overlay for ASUS gaming hardware (fans, CPU, GPU, lighting, profiles)"
arch=('x86_64')
url="https://github.com/Mhsbrian/OmaAsus"
license=('MIT')
depends=('polkit' 'dbus' 'hidapi' 'libxkbcommon' 'wayland' 'vulkan-driver')
optdepends=('coolercontrol: delegate fan curves to CoolerControl'
            'openrgb: lighting control via the OpenRGB SDK'
            'gamemode: automatic profile switching when games register'
            'power-profiles-daemon: platform power profiles'
            'asusctl: ROG laptop / Ally platform control'
            'supergfxctl: hybrid graphics mode switching on laptops'
            'nvidia-utils: NVIDIA GPU control through NVML')
makedepends=('cargo' 'rust')
source=()
sha256sums=()

build() {
  cd "$startdir"
  cargo build --release --locked
}

package() {
  cd "$startdir"
  install -Dm755 target/release/omaasus "$pkgdir/usr/bin/omaasus"
  install -Dm755 target/release/oma "$pkgdir/usr/bin/oma"
  install -Dm755 target/release/oma-helper "$pkgdir/usr/bin/oma-helper"
  install -Dm644 crates/oma-helper/data/com.omaasus.Helper1.conf "$pkgdir/usr/share/dbus-1/system.d/com.omaasus.Helper1.conf"
  install -Dm644 crates/oma-helper/data/com.omaasus.Helper1.service "$pkgdir/usr/share/dbus-1/system-services/com.omaasus.Helper1.service"
  install -Dm644 crates/oma-helper/data/com.omaasus.helper.policy "$pkgdir/usr/share/polkit-1/actions/com.omaasus.helper.policy"
  install -Dm644 crates/oma-helper/data/oma-helper.service "$pkgdir/usr/lib/systemd/system/oma-helper.service"
  install -Dm644 crates/oma-helper/data/70-omaasus.rules "$pkgdir/usr/lib/udev/rules.d/70-omaasus.rules"
  install -Dm644 packaging/omaasus.service "$pkgdir/usr/lib/systemd/user/omaasus.service"
  install -Dm644 packaging/omaasus.desktop "$pkgdir/usr/share/applications/omaasus.desktop"
  install -Dm644 crates/oma-gui/assets/icons/omaasus.svg "$pkgdir/usr/share/icons/hicolor/scalable/apps/omaasus.svg"
  install -Dm644 crates/oma-gui/assets/icons/omaasus-symbolic.svg "$pkgdir/usr/share/icons/hicolor/scalable/apps/omaasus-symbolic.svg"
  install -Dm755 scripts/install-helper.sh "$pkgdir/usr/share/omaasus/install-helper.sh"
  mkdir -p "$pkgdir/usr/share/omaasus/helper"
  cp crates/oma-helper/data/* "$pkgdir/usr/share/omaasus/helper/"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
