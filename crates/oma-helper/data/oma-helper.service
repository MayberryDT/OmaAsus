[Unit]
Description=OmaAsus privileged hardware helper
Documentation=https://github.com/Mhsbrian/OmaAsus

[Service]
Type=dbus
BusName=com.omaasus.Helper1
ExecStart=/usr/bin/oma-helper
Restart=on-failure
# Hardening: the helper only needs sysfs, NVML and hidraw.
ProtectHome=yes
ProtectSystem=strict
ProtectKernelModules=yes
ProtectControlGroups=yes
ProtectClock=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=no
NoNewPrivileges=yes
PrivateTmp=yes
ReadWritePaths=/sys /dev
# Device access by driver group, not by node path: a path such as /dev/nvidia0
# is resolved when the unit starts, and at boot the NVIDIA nodes can appear
# seconds after the driver loads. A missing path silently drops the rule and
# every NVML call then fails with "internal driver error". Groups come from
# /proc/devices and exist as soon as the module is loaded.
DeviceAllow=char-hidraw rw
DeviceAllow=char-nvidia rw
DeviceAllow=char-nvidiactl rw
DeviceAllow=char-nvidia-modeset rw
DeviceAllow=char-nvidia-uvm rw
DeviceAllow=char-nvidia-caps rw
CapabilityBoundingSet=CAP_SYS_ADMIN CAP_SYS_RAWIO CAP_DAC_OVERRIDE

# No [Install] section on purpose: the helper is started by D-Bus activation
# (com.omaasus.Helper1.service) the first time OmaAsus asks for it, once the
# desktop and the graphics driver are up. Starting it at boot only invites the
# race above.
